VITE_FIREBASE_API_KEY=sua-api-key-do-firebase
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
VITE_APP_TITLE=Territórios
VITE_APP_SHORT_NAME=Territórios
VITE_APP_SUBTITLE=Congregação
VITE_APP_DESCRIPTION=Gestão de Territórios de Pregação
VITE_APP_ICON_192=/icon-192.png
VITE_APP_ICON_512=/icon-512.png
VITE_GOOGLE_WEB_CLIENT_ID=seu-client-id-web-do-google.apps.googleusercontent.com
VITE_ONESIGNAL_APP_ID=seu-app-id-do-onesignal
VITE_ONESIGNAL_SAFARI_WEB_ID=seu-safari-web-id-do-onesignal
VITE_NOTIFICATIONS_RELAY_URL=https://seu-worker.workers.dev
VITE_PUBLIC_APP_URL=https://seu-app.web.app
EMAILJS_SERVICE_ID=seu-service-id-do-emailjs
EMAILJS_PUBLIC_KEY=sua-public-key-do-emailjs
EMAILJS_TEMPLATE_ID=seu-template-id-do-emailjs
VITE_LIVE_UPDATE_MANIFEST_URL=https://territorios-idiomas.web.app/live-update/manifest.json
# Deixe vazio para a instancia Idiomas usar apenas enderecos cadastrados.
# Para uma instancia com mapa importado, use algo como ./mapa.general.json.
VITE_MAPA_URL=
VITE_MAP_CENTER_LAT=-26.2503
VITE_MAP_CENTER_LNG=-49.3786
VITE_MAP_INITIAL_ZOOM=14
# Area regional usada pela busca manual de enderecos/coordenadas.
# Default cobre Sao Bento do Sul, Campo Alegre, Rio Negrinho e entorno.
VITE_ADDRESS_SEARCH_VIEWBOX_LEFT=-49.85
VITE_ADDRESS_SEARCH_VIEWBOX_TOP=-25.95
VITE_ADDRESS_SEARCH_VIEWBOX_RIGHT=-49.05
VITE_ADDRESS_SEARCH_VIEWBOX_BOTTOM=-26.55
