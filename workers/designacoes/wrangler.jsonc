{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "territorios-designacoes-local",
  "main": "src/index.js",
  "compatibility_date": "2026-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["TOKEN_KEYS_JSON", "PIN_HMAC_KEY"] },
  "workers_dev": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "PIN_CARD_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
    { "name": "PIN_IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "PIN_CARD_IP_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "ENABLED": "true",
    "CODIGOS_ENABLED": "true",
    "LOCAL_EMULATORS": "true",
    "FIREBASE_PROJECT_ID": "demo-territorios-designacoes",
    "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8185",
    "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9195",
    "PUBLIC_APP_URL": "http://localhost:5185",
    "ALLOWED_ORIGINS": "http://localhost:5185,http://127.0.0.1:5185",
    "TOKEN_KEY_VERSION": "local-v1"
  }
}
